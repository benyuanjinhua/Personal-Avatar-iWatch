  "max_frame_bytes": 65536,
  "max_events_per_second": 200,
  "max_uplink_bytes_per_second": 524288,

  "agent_transport": "mock",
  "provider_key_env": "AUDIO_REALTIME_PROVIDER_KEY"
}
