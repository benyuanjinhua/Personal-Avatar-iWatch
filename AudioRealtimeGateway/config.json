{
  "port": 8444,
  "bind": "0.0.0.0",
  "public_host": "jackson-macmac-mini.magic.workspace.beer",
  "tls_cert": "./certs/gateway.crt",
  "tls_key": "./certs/gateway.key",
  "state_dir": "./state",
  "allowed_peer_ips": ["100.64.0.0/10"],
  "dev_allow_plain_ws": false,
  "protocol_version": 1,

  "max_token_ttl_ms": 90000,
  "default_token_ttl_ms": 30000,
  "timestamp_skew_ms": 300000,

  "token_sweep_interval_ms": 30000,
  "generation_ttl_ms": 3600000,
  "max_tokens": 4096,
  "max_tokens_per_device": 64,
  "max_generation_devices": 64,
  "max_generation_sessions_per_device": 256,

  "heartbeat_interval_ms": 15000,
  "idle_disconnect_ms": 60000,

  "max_frame_bytes": 65536,
  "max_events_per_second": 200,
  "max_uplink_bytes_per_second": 524288,

  "max_downlink_frame_bytes": 131072,
  "max_downlink_frames": 4096,
  "max_downlink_bytes": 33554432,
  "task_state_heartbeat_ms": 2000,
  "max_task_state_frames_per_second": 10,
  "task_state_snapshot_window_ms": 5000,
  "max_downlink_buffered_bytes": 4194304,
  "downlink_backpressure_warn_bytes": 1048576,
  "downlink_close_grace_ms": 5000,

  "agent_transport": "agent",
  "agent_gateway_url": "ws://127.0.0.1:3101/api/realtime",
  "dev_universal_token": "rtk_dev_universal",
  "agent_connect_timeout_ms": 10000,
  "agent_max_pending_bytes": 2097152,
  "agent_response_timeout_ms": 8000,
  "agent_takeover_voice": true,
  "agent_multi_segment_mode": "auto",
  "agent_segment_gap_ms": 2500,
  "agent_segment_gap_busy_ms": 12000,
  "agent_tool_call_window_ms": 30000,
  "fallback_jobs_enabled": false,
  "fallback_hmac_secret_env": "FALLBACK_JOB_HMAC_SECRET",
  "fallback_hmac_secret_file": "./state/fallback-hmac-secret",
  "fallback_bind": "127.0.0.1",
  "fallback_port": 8445,
  "fallback_queue_max_jobs": 64,
  "fallback_queue_timeout_ms": 30000,
  "fallback_turn_state_max_entries": 2048,
  "fallback_upstream_timeout_ms": 30000,
  "fallback_max_audio_bytes": 5242880,
  "provider_key_env": "AUDIO_REALTIME_PROVIDER_KEY"
}
