{
  "port": 8444,
  "bind": "0.0.0.0",
  "public_host": "jackson-macmac-mini.magic.workspace.beer",
  "tls_cert": "./certs/gateway.crt",
  "tls_key": "./certs/gateway.key",
  "state_dir": "./state",
  "allowed_peer_ips": ["100.64.0.0/10"],
  "dev_allow_plain_ws": false,
  "protocol_version": 1,

  "max_token_ttl_ms": 90000,
  "default_token_ttl_ms": 30000,
  "timestamp_skew_ms": 300000,

  "heartbeat_interval_ms": 15000,
  "idle_disconnect_ms": 60000,

  "max_frame_bytes": 65536,
  "max_events_per_second": 200,
  "max_uplink_bytes_per_second": 524288,

  "max_downlink_frame_bytes": 131072,
  "max_downlink_frames": 4096,
  "max_downlink_bytes": 33554432,
  "max_downlink_buffered_bytes": 4194304,
  "downlink_backpressure_warn_bytes": 1048576,
  "downlink_close_grace_ms": 5000,

  "agent_transport": "agent",
  "agent_gateway_url": "ws://127.0.0.1:3101/api/realtime",
  "agent_connect_timeout_ms": 10000,
  "agent_max_pending_bytes": 2097152,
  "agent_takeover_voice": true,
  "provider_key_env": "AUDIO_REALTIME_PROVIDER_KEY"
}
